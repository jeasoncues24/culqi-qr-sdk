# Copia este archivo a .env y completa los valores.

# -------------------------------------------------------------------
# OBLIGATORIO
# -------------------------------------------------------------------

# Tu clave secreta de Culqi.
# Pruebas:    sk_test_xxxxxxxxxxxxxxxxxxxx  (panel de Culqi → API Keys)
# Producción: sk_live_xxxxxxxxxxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------------------
# OPCIONAL
# -------------------------------------------------------------------

# Puerto en el que escucha el servidor (por defecto: 3000)
PORT=3000

# URL pública de tu servidor. Culqi la usa para enviar webhooks.
# Desarrollo local → usa ngrok:  ngrok http 3000
# Producción       → tu dominio: https://api.tutienda.com
PUBLIC_URL=https://abc123.ngrok.io
